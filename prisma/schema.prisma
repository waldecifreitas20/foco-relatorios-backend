// This is your Prisma schema file,
// learn more about it in the docspris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Order {
  ticket       String @id
  plate        String 
  client       String
  service      String
  status       String
  provider     String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now())
  eta          Int?         
  agentName    String?
  hasChecklist Boolean?     @default(false)

  notes OrderNote[]

}

model OrderNote {
  orderTicket String @id
  note        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  order Order @relation(fields: [orderTicket], references: [ticket])
}
