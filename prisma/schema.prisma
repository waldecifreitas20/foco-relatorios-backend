generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Order {
  ticket       String      @id
  plate        String
  date         String      @default("")
  client       String
  service      String
  status       String
  provider     String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  eta          Int?
  agentName    String?
  hasChecklist Boolean?    @default(false)
  notes        OrderNote[]
}

model OrderNote {
  id          Int      @id @default(autoincrement())
  orderTicket String
  note        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order    @relation(fields: [orderTicket], references: [ticket])
}
